# ---- Web Push (meal notifications) -------------------------------------------------
# Generate your own pair ONCE:   npx web-push generate-vapid-keys
# Put the PUBLIC key in src/utils/pushNotifications.ts (VAPID_PUBLIC_KEY) and in VAPID_PUBLIC_KEY below.
# Keep the PRIVATE key secret: set it only here / in Vercel -> Settings -> Environment Variables.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Optional: protects /api/cron. If set, GitHub Actions must send the same value (secret CRON_SECRET).
CRON_SECRET=""

# Optional (Node server only): set to "true" to turn off the built-in every-minute alert timer
# (use it if you rely on GitHub Actions instead).
# DISABLE_SCHEDULER="false"

# Optional overrides (defaults are the project's own Firebase project)
# FIREBASE_PROJECT_ID=""
# FIREBASE_API_KEY=""
