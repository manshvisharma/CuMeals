rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Leaderboards collection: Public read and write for all players
    match /leaderboards/{leaderboardId} {
      allow read, write: if true;
    }

    // Public read for menus, admin full access
    match /menus/{dateId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public read for timings, admin full access
    match /timings/{timingDoc} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public read for notices, admin full access
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public read for settings, admin full access
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Feedbacks collection
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Admins collection
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Multiplayer collections
    match /presence/{uid} {
      allow read, write: if true;
    }
    
    match /challenges/{challengeId} {
      allow read, write: if true;
    }
    
    match /game_sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
