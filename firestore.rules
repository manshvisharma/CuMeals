rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if signed in user is an admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "17monusharma@gmail.com" ||
        request.auth.token.email == "17monuSHARMA@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Public read for menus, signed in user or admin can write
    match /menus/{dateId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public read for timings, signed in user or admin can write
    match /timings/{timingDoc} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public read for notices, signed in user or admin can write
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public read for settings, signed in user or admin can write
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Leaderboards: everyone can read & record game scores
    match /leaderboards/{scoreId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Feedbacks & suggestions
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Admins collection
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
